// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String    @id @unique @default(uuid())
  name      String    @unique
  users     User[]
  products  Product[]
  orders    Order[]
  createdAt DateTime  @default(now())
}

model Session {
  id        String   @id @default(uuid())
  hash      String
  target    String // email or phone
  createdAt DateTime @default(now())
  expiredAt DateTime
  isCompany Boolean  @default(false)

  @@index([target])
  @@index([expiredAt])
}

model Otp {
  id        String   @id @default(uuid())
  hash      String   @unique
  target    String // email or phone
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  expiredAt DateTime

  @@index([target])
  @@index([expiredAt])
}

model User {
  id        String   @id @unique @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id            String   @id @unique @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String   @unique
  sku           String   @unique
  price         Float
  stockQuantity Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id          String      @id @unique @default(uuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id])
  clientName  String
  clientEmail String
  totalAmount Float
  paymentType PaymentType
  payments    Payment[]
  credit      Credit?
  createdAt   DateTime    @default(now())
  products    Cart[]
}

model Cart {
  id          String   @id @unique @default(uuid())
  order       Order    @relation(fields: [orderId], references: [id])
  orderId     String
  productName String
  quantity    String
  totalPrice  Float
  createdAt   DateTime @default(now())
}

model Payment {
  id          String   @id @unique @default(uuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  amountPaid  Float
  paymentDate DateTime @default(now())
}

model Credit {
  id              String       @id @default(uuid())
  orderId         String       @unique
  order           Order        @relation(fields: [orderId], references: [id])
  totalAmount     Float
  paidAmount      Float
  remainingAmount Float
  dueDate         DateTime
  status          CreditStatus
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum PaymentType {
  CASH
  CREDIT
}

enum CreditStatus {
  PENDING
  PAID
  OVERDUE
}
