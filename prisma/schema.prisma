// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String    @id @unique @default(uuid())
  name      String    @unique
  users     User[]
  products  Product[]
  orders    Order[]
  clients   Client[]
  createdAt DateTime  @default(now())
  salaries  Salary[]
  costs     Cost[]
}

model Session {
  id        String   @id @default(uuid())
  hash      String
  target    String // email or phone
  createdAt DateTime @default(now())
  expiredAt DateTime
  isCompany Boolean  @default(false)

  @@index([target])
  @@index([expiredAt])
}

model Otp {
  id        String   @id @default(uuid())
  hash      String   @unique
  target    String // email or phone
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  expiredAt DateTime

  @@index([target])
  @@index([expiredAt])
}

model User {
  id        String   @id @unique @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  salaries  Salary[]
}

model Salary {
  id        String   @id @unique @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Float
  createdAt DateTime @default(now())
}

model Client {
  id        String   @id @unique @default(uuid())
  companyId String
  number    String   @unique
  name      String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])
}

model Product {
  id            String   @id @unique @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  sku           String   @unique
  price         Float
  stockQuantity Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id          String          @id @unique @default(uuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id])
  totalAmount Float
  payments    Payment[]
  createdAt   DateTime        @default(now())
  products    Cart[]
  clientId    String
  orderNumber String          @unique
  credit      Credit?
  status      Status          @default(WAITING)
  paidAmount  Float           @default(0)
  delivery    DeliveredStatus @default(PENDING)

  @@index([clientId])
}

model Cost {
  id        String   @id @unique @default(uuid())
  comment   String
  createdAt DateTime @default(now())
  amount    Float
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
}

model Cart {
  id          String   @id @unique @default(uuid())
  order       Order    @relation(fields: [orderId], references: [id])
  orderId     String
  productId   String
  productName String
  quantity    Int
  totalPrice  Float
  createdAt   DateTime @default(now())
}

model Payment {
  id            String      @id @unique @default(uuid())
  order         Order       @relation(fields: [orderNumber], references: [orderNumber])
  amountPaid    Float
  paymentDate   DateTime    @default(now())
  orderNumber   String
  paymentNumber String      @unique
  type          PaymentType @default(COMPLET)
  companyId     String
  clientName    String
  clientPhone   String

  @@index([clientPhone])
}

model Credit {
  id              String       @id @default(uuid())
  totalAmount     Float
  paidAmount      Float
  remainingAmount Float
  dueDate         DateTime
  status          CreditStatus
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  orderNumber     String       @unique
  order           Order?       @relation(fields: [orderNumber], references: [orderNumber])
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum PaymentType {
  COMPLET
  ECHEANCE
}

enum CreditStatus {
  PENDING
  PAID
  OVERDUE
}

enum Status {
  FINISH
  PARTIAL
  WAITING
  CANCEL
}

enum DeliveredStatus {
  DELIVERD
  PENDING
}
